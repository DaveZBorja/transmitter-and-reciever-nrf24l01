#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

#define CE_PIN 9
#define CSN_PIN 10
#define SOIL_MOISTURE_PIN A0
#define RELAY_PIN 7
#define MOISTURE_THRESHOLD 500

RF24 radio(CE_PIN, CSN_PIN);
const byte address[6] = "00001";

void setup() {
    Serial.begin(9600);
    pinMode(RELAY_PIN, OUTPUT);
    radio.begin();
    radio.openWritingPipe(address);
    radio.setPALevel(RF24_PA_LOW);
    radio.stopListening();
}

void loop() {
    int moistureValue = analogRead(SOIL_MOISTURE_PIN);
    Serial.print("Moisture Value: ");
    Serial.println(moistureValue);
    radio.write(&moistureValue, sizeof(moistureValue));
    delay(1000);
}

// Receiver Code
#include <SPI.h>
#include <nRF24L01.h>
#include <RF24.h>

#define CE_PIN 9
#define CSN_PIN 10
#define RELAY_PIN 7
#define MOISTURE_THRESHOLD 500

RF24 radio(CE_PIN, CSN_PIN);
const byte address[6] = "00001";

void setup() {
    Serial.begin(9600);
    pinMode(RELAY_PIN, OUTPUT);
    radio.begin();
    radio.openReadingPipe(0, address);
    radio.setPALevel(RF24_PA_LOW);
    radio.startListening();
}

void loop() {
    if (radio.available()) {
        int moistureValue;
        radio.read(&moistureValue, sizeof(moistureValue));
        Serial.print("Received Moisture Value: ");
        Serial.println(moistureValue);
        
        if (moistureValue < MOISTURE_THRESHOLD) {
            digitalWrite(RELAY_PIN, HIGH);
            Serial.println("Relay ON");
        } else {
            digitalWrite(RELAY_PIN, LOW);
            Serial.println("Relay OFF");
        }
    }
    delay(500);
}
